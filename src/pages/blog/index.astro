---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.fechaPublicacion).getTime() - new Date(a.data.fechaPublicacion).getTime()
);

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Guía Rural y Blog', url: '/blog' }
];
---

<Layout
  title="Guía Rural y Blog del Valle del Tiétar | Casa Rojo del Tiétar"
  description="Artículos, rutas de senderismo GR-63 Senda de Viriato, gastronomía típica, piscinas naturales y planes para grupos en La Iglesuela del Tiétar y Sierra de San Vicente."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section class="relative pt-32 pb-20 lg:pt-40 lg:pb-24 bg-[#1c1b1a] text-white overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-35">
      <img
        src="/uploads/PANORAMICA.-LA-IGLESUELA-DEL-TIETAR.jpg"
        alt="Guía Rural del Valle del Tiétar y La Iglesuela"
        class="w-full h-full object-cover"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[#1c1b1a] via-[#1c1b1a]/75 to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-xs uppercase tracking-widest text-stone-300">
          <li><a href="/" class="hover:text-white transition-colors">Inicio</a></li>
          <li>/</li>
          <li class="text-[#ffb4a0] font-semibold">Guía Rural y Blog</li>
        </ol>
      </nav>

      <div class="max-w-3xl">
        <span class="inline-block px-3.5 py-1.5 rounded-full bg-[#703829]/80 border border-[#ffb4a0]/30 text-[#ffb4a0] text-xs font-bold uppercase tracking-widest mb-4">
          Cuaderno de Viaje · Gestionado con Keystatic CMS
        </span>
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6">
          Guía Rural del <span class="italic font-normal text-[#ffb4a0]">Valle del Tiétar</span>
        </h1>
        <p class="text-stone-300 text-lg leading-relaxed">
          Descubre nuestras recomendaciones locales sobre rutas de senderismo, pozas cristalinas, gastronomía toledana y planes en grupo desde <strong>Casa Rojo del Tiétar</strong>.
        </p>
      </div>
    </div>
  </section>

  <!-- Blog Grid -->
  <section class="py-24 bg-[#fff8f5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <article class="group bg-white rounded-3xl overflow-hidden border border-stone-200/80 shadow-xs hover:shadow-xl transition-all flex flex-col justify-between">
            <div>
              <a href={`/blog/${post.id}`} class="block relative aspect-[16/10] overflow-hidden bg-stone-100">
                <img
                  src={post.data.imagenDestacada}
                  alt={post.data.titulo}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  loading="lazy"
                />
                <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-stone-900/80 backdrop-blur-xs text-[#ffb4a0] text-xs font-bold uppercase tracking-wider">
                  {post.data.categoria}
                </span>
              </a>
              <div class="p-7">
                <div class="flex items-center gap-3 text-xs text-stone-400 mb-3">
                  <time datetime={post.data.fechaPublicacion}>
                    {new Date(post.data.fechaPublicacion).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
                  </time>
                  <span>•</span>
                  <span>{post.data.tiempoLectura}</span>
                </div>
                <h2 class="font-serif text-xl font-bold text-stone-900 mb-3 group-hover:text-[#703829] transition-colors leading-snug">
                  <a href={`/blog/${post.id}`}>{post.data.titulo}</a>
                </h2>
                <p class="text-stone-600 text-sm leading-relaxed line-clamp-3">
                  {post.data.extracto}
                </p>
              </div>
            </div>
            <div class="px-7 pb-7 pt-3 border-t border-stone-100">
              <a href={`/blog/${post.id}`} class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#703829] group-hover:translate-x-1 transition-transform">
                Leer artículo completo →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
