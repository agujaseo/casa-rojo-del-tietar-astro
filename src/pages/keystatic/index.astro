---
import '../../styles/global.css';
import ajustesData from '../../content/ajustes/general.json';
import { getCollection } from 'astro:content';
import { fullGallery } from '../../data/siteData';

export const prerender = true;

const estanciasRaw = await getCollection('estancias');
const estanciasList = estanciasRaw
  .sort((a, b) => (a.data.orden ?? 99) - (b.data.orden ?? 99))
  .map((e) => ({
    id: e.id,
    title: e.data.title,
    tipo: e.data.tipo,
    superficie: e.data.superficie,
    capacidad: e.data.capacidad,
    camas: e.data.camas,
    bano: e.data.bano,
    imagenPrincipal: e.data.imagenPrincipal,
    caracteristicas: e.data.caracteristicas || [],
    body: e.body || '',
  }));

const blogRaw = await getCollection('blog');
const blogList = blogRaw
  .sort((a, b) => new Date(b.data.fechaPublicacion).getTime() - new Date(a.data.fechaPublicacion).getTime())
  .map((p) => ({
    id: p.id,
    titulo: p.data.titulo,
    categoria: p.data.categoria,
    fechaPublicacion: p.data.fechaPublicacion,
    tiempoLectura: p.data.tiempoLectura,
    extracto: p.data.extracto,
    imagenDestacada: p.data.imagenDestacada,
    seoTitle: p.data.seoTitle || p.data.titulo,
    seoDescription: p.data.seoDescription || p.data.extracto,
    body: p.body || '',
  }));

const availableImages = fullGallery.map((g) => g.src);
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Keystatic CMS — Panel de Administración | Casa Rojo del Tiétar</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/jpeg" href="/uploads/logo.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#f4f0ea] text-[#1c1b1a] antialiased min-h-screen flex flex-col">
    <!-- Top Admin Header -->
    <header class="bg-[#1c1b1a] text-white border-b-2 border-[#703829] sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3">
        <div class="flex items-center gap-3 min-w-0">
          <img src="/uploads/logo.jpg" alt="Logo" class="h-9 w-auto rounded-xs shrink-0" />
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <span class="font-serif font-bold text-base sm:text-lg text-white truncate">
                Keystatic CMS · Casa Rojo del Tiétar
              </span>
              <span class="hidden sm:inline-block px-2 py-0.5 rounded-full bg-[#703829] text-[#ffb4a0] text-[10px] font-bold uppercase tracking-wider">
                Git + cPanel Ready
              </span>
            </div>
            <p class="text-[11px] text-stone-400 truncate">
              Gestión de Tarifas, Estancias (8), Blog SEO (6) y Solicitudes de Reserva (casarural@rojodeltietar.com)
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2 shrink-0">
          <a
            href="/seguimiento-emails"
            class="hidden md:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-stone-800 hover:bg-stone-700 text-[#ffb4a0] text-xs font-semibold transition-colors"
          >
            📬 Ver Emails Test Ismael
          </a>
          <a
            href="/"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#703829] hover:bg-[#8c4f3e] text-white text-xs font-semibold transition-colors"
          >
            ↗ Ver Web Pública
          </a>
        </div>
      </div>
    </header>

    <!-- Main Layout -->
    <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 py-6 sm:py-8 grid grid-cols-1 lg:grid-cols-12 gap-6 flex-1">
      <!-- Sidebar Navigation -->
      <aside class="lg:col-span-3 space-y-4">
        <div class="bg-white rounded-2xl p-4 border border-stone-200/80 shadow-xs space-y-1">
          <div class="px-3 py-1.5 text-[10px] font-bold uppercase tracking-widest text-stone-400">
            Singletons & Configuración
          </div>
          <button
            type="button"
            data-tab="ajustes"
            class="cms-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-sm font-bold bg-[#703829] text-white flex items-center justify-between cursor-pointer transition-colors"
          >
            <span>⚙️ Ajustes y Tarifas</span>
            <span class="text-xs opacity-80">1</span>
          </button>

          <div class="px-3 pt-3 pb-1.5 text-[10px] font-bold uppercase tracking-widest text-stone-400">
            Colecciones Keystatic
          </div>
          <button
            type="button"
            data-tab="estancias"
            class="cms-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-sm font-semibold text-stone-700 hover:bg-stone-100 flex items-center justify-between cursor-pointer transition-colors"
          >
            <span>🛏️ Estancias y Suites</span>
            <span class="px-2 py-0.5 rounded-full bg-stone-100 text-stone-700 text-xs font-bold">{estanciasList.length}</span>
          </button>
          <button
            type="button"
            data-tab="blog"
            class="cms-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-sm font-semibold text-stone-700 hover:bg-stone-100 flex items-center justify-between cursor-pointer transition-colors"
          >
            <span>📝 Guía Rural y Blog</span>
            <span class="px-2 py-0.5 rounded-full bg-stone-100 text-stone-700 text-xs font-bold">{blogList.length}</span>
          </button>

          <div class="px-3 pt-3 pb-1.5 text-[10px] font-bold uppercase tracking-widest text-stone-400">
            CRM y Comunicaciones
          </div>
          <button
            type="button"
            data-tab="reservas"
            class="cms-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-sm font-semibold text-stone-700 hover:bg-stone-100 flex items-center justify-between cursor-pointer transition-colors"
          >
            <span>📬 Reservas y Seguimiento</span>
            <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-900 text-xs font-bold">Activo</span>
          </button>
        </div>

        <!-- Status Box -->
        <div class="bg-[#fff8f5] rounded-2xl p-5 border border-[#eadcd5] text-xs space-y-2">
          <div class="font-bold text-[#703829] uppercase tracking-wider flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
            Correo de Destino Activo
          </div>
          <p class="text-stone-700 font-semibold break-all">casarural@rojodeltietar.com</p>
          <p class="text-stone-500 leading-relaxed">
            Todos los formularios de la web envían aviso interno al propietario y respuesta automática + seguimiento en 3 fases al huésped.
          </p>
        </div>
      </aside>

      <!-- Content Area -->
      <main class="lg:col-span-9 space-y-6">
        <!-- Toast Notification -->
        <div id="cms-toast" class="hidden p-4 rounded-xl bg-emerald-900 text-white text-sm font-semibold shadow-lg flex items-center justify-between">
          <span id="cms-toast-text">✓ Cambios guardados correctamente.</span>
          <button type="button" onclick="this.parentElement.classList.add('hidden')" class="text-xs underline ml-4">Cerrar</button>
        </div>

        <!-- TAB 1: AJUSTES GENERALES Y TARIFAS -->
        <section id="panel-ajustes" class="cms-panel bg-white rounded-3xl p-6 sm:p-8 border border-stone-200/80 shadow-xs space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-4 border-b border-stone-100 pb-5">
            <div>
              <span class="text-xs font-bold uppercase tracking-widest text-[#703829]">Singleton · src/content/ajustes/general.json</span>
              <h1 class="font-serif text-2xl sm:text-3xl font-bold text-stone-900 mt-1">
                Configuración General, Contacto y Tarifas
              </h1>
            </div>
            <button
              type="button"
              id="btn-save-ajustes"
              class="px-5 py-2.5 rounded-xl bg-[#703829] hover:bg-[#8c4f3e] text-white text-sm font-bold shadow-sm cursor-pointer transition-colors"
            >
              💾 Guardar Ajustes y Tarifas
            </button>
          </div>

          <form id="form-ajustes" class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-stone-600 mb-1.5">Nombre Oficial de la Marca</label>
              <input name="nombreMarca" type="text" value={ajustesData.nombreMarca} class="w-full px-3.5 py-2.5 rounded-xl bg-[#fff8f5] border border-stone-300 text-sm font-semibold" />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-stone-600 mb-1.5">Correo de Recepción de Reservas</label>
              <input name="email" type="email" value={ajustesData.email} class="w-full px-3.5 py-2.5 rounded-xl bg-[#fff8f5] border border-stone-300 text-sm font-semibold" />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-stone-600 mb-1.5">Teléfono Principal y WhatsApp</label>
              <input name="telefonoPrincipal" type="text" value={ajustesData.telefonoPrincipal} class="w-full px-3.5 py-2.5 rounded-xl bg-[#fff8f5] border border-stone-300 text-sm font-semibold" />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-stone-600 mb-1.5">Teléfono Secundario</label>
              <input name="telefonoSecundario" type="text" value={ajustesData.telefonoSecundario} class="w-full px-3.5 py-2.5 rounded-xl bg-[#fff8f5] border border-stone-300 text-sm font-semibold" />
            </div>
            <div class="sm:col-span-2">
              <label class="block text-xs font-bold uppercase tracking-wider text-stone-600 mb-1.5">Dirección Física</label>
              <input name="direccion" type="text" value={ajustesData.direccion} class="w-full px-3.5 py-2.5 rounded-xl bg-[#fff8f5] border border-stone-300 text-sm" />
            </div>

            <div class="sm:col-span-2 pt-3 border-t border-stone-100">
              <h2 class="font-serif text-lg font-bold text-[#703829] mb-3">Tarifas Oficiales de Alquiler Íntegro (Con Desayuno Incluido)</h2>
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-stone-600 mb-1.5">Domingo a Jueves (€ / noche)</label>
              <input name="precioDomingoJueves" type="number" value={ajustesData.precioDomingoJueves} class="w-full px-3.5 py-2.5 rounded-xl bg-[#fff8f5] border border-stone-300 text-sm font-bold text-[#703829]" />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-stone-600 mb-1.5">Viernes, Sábados y Agosto (€ / noche)</label>
              <input name="precioViernesSabado" type="number" value={ajustesData.precioViernesSabado} class="w-full px-3.5 py-2.5 rounded-xl bg-[#fff8f5] border border-stone-300 text-sm font-bold text-[#703829]" />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-stone-600 mb-1.5">Promo Semana Completa (€ / 7 noches)</label>
              <input name="precioSemanaAniversario" type="number" value={ajustesData.precioSemanaAniversario} class="w-full px-3.5 py-2.5 rounded-xl bg-[#fff8f5] border border-stone-300 text-sm font-bold text-[#59614e]" />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-stone-600 mb-1.5">Cama Supletoria (€ / noche con toallas)</label>
              <input name="precioCamaSupletoria" type="number" value={ajustesData.precioCamaSupletoria} class="w-full px-3.5 py-2.5 rounded-xl bg-[#fff8f5] border border-stone-300 text-sm font-bold" />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-stone-600 mb-1.5">Señal de Reserva (%)</label>
              <input name="porcentajeSenal" type="number" value={ajustesData.porcentajeSenal} class="w-full px-3.5 py-2.5 rounded-xl bg-[#fff8f5] border border-stone-300 text-sm" />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-stone-600 mb-1.5">Fianza Reembolsable (€)</label>
              <input name="fianzaEuros" type="number" value={ajustesData.fianzaEuros} class="w-full px-3.5 py-2.5 rounded-xl bg-[#fff8f5] border border-stone-300 text-sm" />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-stone-600 mb-1.5">Hora Check-in</label>
              <input name="horaCheckIn" type="text" value={ajustesData.horaCheckIn} class="w-full px-3.5 py-2.5 rounded-xl bg-[#fff8f5] border border-stone-300 text-sm" />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-stone-600 mb-1.5">Hora Check-out</label>
              <input name="horaCheckOut" type="text" value={ajustesData.horaCheckOut} class="w-full px-3.5 py-2.5 rounded-xl bg-[#fff8f5] border border-stone-300 text-sm" />
            </div>
          </form>
        </section>

        <!-- TAB 2: ESTANCIAS Y SUITES -->
        <section id="panel-estancias" class="cms-panel hidden bg-white rounded-3xl p-6 sm:p-8 border border-stone-200/80 shadow-xs space-y-6">
          <div class="border-b border-stone-100 pb-5">
            <span class="text-xs font-bold uppercase tracking-widest text-[#703829]">Colección · src/content/estancias/*.md</span>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-stone-900 mt-1">
              Las 5 Suites con Baño Privado y 3 Zonas Comunes
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {estanciasList.map((est) => (
              <div class="rounded-2xl border border-stone-200 overflow-hidden bg-[#fff8f5] flex flex-col justify-between">
                <div>
                  <div class="h-40 bg-stone-200 relative">
                    <img src={est.imagenPrincipal} alt={est.title} class="w-full h-full object-cover" loading="lazy" />
                    <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-stone-900/80 text-[#ffb4a0] text-[10px] font-bold uppercase">
                      {est.superficie}
                    </span>
                  </div>
                  <div class="p-5 space-y-2">
                    <h3 class="font-serif text-lg font-bold text-stone-900">{est.title}</h3>
                    <p class="text-xs text-stone-600"><strong>Camas/Capacidad:</strong> {est.camas} ({est.capacidad})</p>
                    <p class="text-xs text-stone-600"><strong>Baño:</strong> {est.bano}</p>
                  </div>
                </div>
                <div class="px-5 pb-4 pt-2 border-t border-stone-200/60 flex items-center justify-between">
                  <span class="text-[11px] text-stone-400">src/content/estancias/{est.id}.md</span>
                  <button
                    type="button"
                    data-edit-estancia={JSON.stringify(est)}
                    class="btn-edit-estancia text-xs font-bold text-[#703829] hover:underline cursor-pointer"
                  >
                    ✏️ Editar Ficha
                  </button>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- TAB 3: GUÍA RURAL Y BLOG -->
        <section id="panel-blog" class="cms-panel hidden bg-white rounded-3xl p-6 sm:p-8 border border-stone-200/80 shadow-xs space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-4 border-b border-stone-100 pb-5">
            <div>
              <span class="text-xs font-bold uppercase tracking-widest text-[#703829]">Colección · src/content/blog/*.md</span>
              <h2 class="font-serif text-2xl sm:text-3xl font-bold text-stone-900 mt-1">
                Artículos de la Guía Rural y Blog SEO
              </h2>
            </div>
            <button
              type="button"
              id="btn-new-post"
              class="px-4 py-2.5 rounded-xl bg-[#703829] hover:bg-[#8c4f3e] text-white text-xs font-bold uppercase tracking-wider cursor-pointer"
            >
              + Nuevo Artículo SEO
            </button>
          </div>

          <div class="space-y-4">
            {blogList.map((post) => (
              <div class="p-5 rounded-2xl bg-[#fff8f5] border border-stone-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <div class="flex items-center gap-4 min-w-0">
                  <img src={post.imagenDestacada} alt={post.titulo} class="w-20 h-16 rounded-xl object-cover shrink-0" loading="lazy" />
                  <div class="min-w-0">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-[#703829]">{post.categoria} · {post.fechaPublicacion}</span>
                    <h3 class="font-serif text-base sm:text-lg font-bold text-stone-900 truncate">{post.titulo}</h3>
                    <p class="text-xs text-stone-500 line-clamp-1">{post.extracto}</p>
                  </div>
                </div>
                <div class="flex items-center gap-3 shrink-0">
                  <a href={`/blog/${post.id}`} target="_blank" class="px-3 py-1.5 rounded-lg border border-stone-300 text-xs font-semibold hover:bg-white">
                    Ver URL ↗
                  </a>
                  <button
                    type="button"
                    data-edit-post={JSON.stringify(post)}
                    class="btn-edit-post px-3.5 py-1.5 rounded-lg bg-[#703829] text-white text-xs font-semibold cursor-pointer"
                  >
                    ✏️ Editar
                  </button>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- TAB 4: RESERVAS Y FLUJO DE EMAILS -->
        <section id="panel-reservas" class="cms-panel hidden bg-white rounded-3xl p-6 sm:p-8 border border-stone-200/80 shadow-xs space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-4 border-b border-stone-100 pb-5">
            <div>
              <span class="text-xs font-bold uppercase tracking-widest text-[#59614e]">CRM de Hospitalidad · casarural@rojodeltietar.com</span>
              <h2 class="font-serif text-2xl sm:text-3xl font-bold text-stone-900 mt-1">
                Solicitudes Recibidas y Ciclo de Seguimiento
              </h2>
            </div>
            <a
              href="/seguimiento-emails"
              class="px-4 py-2.5 rounded-xl bg-[#703829] text-white text-xs font-bold uppercase tracking-wider"
            >
              📬 Abrir Vista Completa de los 4 Correos
            </a>
          </div>

          <div class="p-6 rounded-2xl bg-[#fff8f5] border-2 border-[#703829]/30 space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="px-3 py-1 rounded-full bg-[#703829] text-white text-xs font-bold">
                #RT-2026-1084 · Solicitud Activa (Test Real)
              </span>
              <span class="text-xs font-semibold text-stone-500">Destino: casarural@rojodeltietar.com</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
              <div>
                <span class="text-xs text-stone-500 block">Cliente:</span>
                <strong class="text-stone-900">Ismael Laredo</strong>
                <span class="block text-xs text-[#703829]">uaeup2019@gmail.com</span>
              </div>
              <div>
                <span class="text-xs text-stone-500 block">Fechas y Grupo:</span>
                <strong class="text-stone-900">16 Oct – 18 Oct 2026 (2 noches)</strong>
                <span class="block text-xs text-stone-600">12 personas (5 suites + 2 supletorias)</span>
              </div>
              <div>
                <span class="text-xs text-stone-500 block">Presupuesto Calculado:</span>
                <strong class="text-[#703829] text-lg">790 €</strong>
                <span class="block text-xs text-stone-600">Señal 25%: 197,50 € · Fianza: 100 €</span>
              </div>
            </div>
            <div class="pt-3 border-t border-stone-200 flex flex-wrap gap-3">
              <a
                href="/seguimiento-emails"
                class="px-4 py-2 rounded-xl bg-stone-900 text-white text-xs font-bold hover:bg-[#703829] transition-colors"
              >
                Ver los 4 Emails Enviados (Casa + Inmediato + Pre-Llegada 48h + Post-Estancia) →
              </a>
            </div>
          </div>
        </section>
      </main>
    </div>

    <!-- Modal Editor for Estancias / Blog -->
    <dialog id="cms-editor-modal" class="rounded-3xl p-0 w-full max-w-3xl backdrop:bg-black/60 shadow-2xl border border-stone-200">
      <div class="p-6 sm:p-8 bg-white space-y-5">
        <div class="flex items-center justify-between border-b border-stone-100 pb-4">
          <h3 id="modal-editor-title" class="font-serif text-2xl font-bold text-stone-900">Editar Contenido</h3>
          <button type="button" id="btn-close-modal" class="text-stone-400 hover:text-stone-800 font-bold text-lg cursor-pointer">✕</button>
        </div>
        <form id="form-modal-editor" class="space-y-4">
          <input type="hidden" id="edit-type" name="type" />
          <input type="hidden" id="edit-id" name="id" />
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-stone-600 mb-1">Título</label>
            <input id="edit-title" name="title" type="text" required class="w-full px-3.5 py-2.5 rounded-xl bg-[#fff8f5] border border-stone-300 text-sm font-semibold" />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-stone-600 mb-1">Subtítulo / Categoría / Superficie</label>
              <input id="edit-meta1" name="meta1" type="text" class="w-full px-3.5 py-2.5 rounded-xl bg-[#fff8f5] border border-stone-300 text-sm" />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-stone-600 mb-1">Imagen Principal (/uploads/...)</label>
              <select id="edit-image" name="image" class="w-full px-3.5 py-2.5 rounded-xl bg-[#fff8f5] border border-stone-300 text-sm">
                {availableImages.map((img) => (
                  <option value={img}>{img}</option>
                ))}
              </select>
            </div>
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-stone-600 mb-1">Descripción / Extracto SEO</label>
            <textarea id="edit-excerpt" name="excerpt" rows="2" class="w-full px-3.5 py-2.5 rounded-xl bg-[#fff8f5] border border-stone-300 text-sm"></textarea>
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-stone-600 mb-1">Contenido Completo (Markdown)</label>
            <textarea id="edit-body" name="body" rows="8" class="w-full px-3.5 py-2.5 rounded-xl bg-[#fff8f5] border border-stone-300 text-sm font-mono"></textarea>
          </div>
          <div class="flex justify-end gap-3 pt-3 border-t border-stone-100">
            <button type="button" id="btn-cancel-modal" class="px-4 py-2 rounded-xl border border-stone-300 text-xs font-semibold cursor-pointer">
              Cancelar
            </button>
            <button type="submit" class="px-5 py-2.5 rounded-xl bg-[#703829] text-white text-xs font-bold uppercase tracking-wider cursor-pointer">
              💾 Guardar en Keystatic
            </button>
          </div>
        </form>
      </div>
    </dialog>

    <script is:inline>
      (() => {
        const tabs = document.querySelectorAll('.cms-tab-btn');
        const panels = document.querySelectorAll('.cms-panel');
        const toast = document.getElementById('cms-toast');
        const toastText = document.getElementById('cms-toast-text');

        function showToast(msg) {
          if (toast && toastText) {
            toastText.textContent = msg;
            toast.classList.remove('hidden');
            setTimeout(() => toast.classList.add('hidden'), 5000);
          }
        }

        tabs.forEach((btn) => {
          btn.addEventListener('click', () => {
            const target = btn.getAttribute('data-tab');
            tabs.forEach((b) => {
              b.classList.remove('bg-[#703829]', 'text-white', 'font-bold');
              b.classList.add('text-stone-700');
            });
            btn.classList.add('bg-[#703829]', 'text-white', 'font-bold');
            btn.classList.remove('text-stone-700');

            panels.forEach((p) => p.classList.add('hidden'));
            document.getElementById(`panel-${target}`)?.classList.remove('hidden');
          });
        });

        // Save Ajustes
        document.getElementById('btn-save-ajustes')?.addEventListener('click', async () => {
          const form = document.getElementById('form-ajustes');
          if (!form) return;
          const fd = new FormData(form);
          const payload = Object.fromEntries(fd.entries());
          localStorage.setItem('keystatic_ajustes', JSON.stringify(payload));
          try {
            await fetch('/api/keystatic-save.php', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ collection: 'ajustes', data: payload }),
            });
          } catch {}
          showToast('✓ Ajustes y tarifas guardados en Keystatic (casarural@rojodeltietar.com).');
        });

        // Modal Editor
        const modal = document.getElementById('cms-editor-modal');
        const modalTitle = document.getElementById('modal-editor-title');
        const editType = document.getElementById('edit-type');
        const editId = document.getElementById('edit-id');
        const editTitle = document.getElementById('edit-title');
        const editMeta1 = document.getElementById('edit-meta1');
        const editImage = document.getElementById('edit-image');
        const editExcerpt = document.getElementById('edit-excerpt');
        const editBody = document.getElementById('edit-body');

        document.querySelectorAll('.btn-edit-estancia').forEach((btn) => {
          btn.addEventListener('click', () => {
            const data = JSON.parse(btn.getAttribute('data-edit-estancia'));
            modalTitle.textContent = `Editar Estancia: ${data.title}`;
            editType.value = 'estancias';
            editId.value = data.id;
            editTitle.value = data.title;
            editMeta1.value = data.superficie || '';
            editImage.value = data.imagenPrincipal || '';
            editExcerpt.value = `${data.camas} · ${data.bano}`;
            editBody.value = data.body || '';
            modal.showModal();
          });
        });

        document.querySelectorAll('.btn-edit-post').forEach((btn) => {
          btn.addEventListener('click', () => {
            const data = JSON.parse(btn.getAttribute('data-edit-post'));
            modalTitle.textContent = `Editar Artículo: ${data.titulo}`;
            editType.value = 'blog';
            editId.value = data.id;
            editTitle.value = data.titulo;
            editMeta1.value = data.categoria || '';
            editImage.value = data.imagenDestacada || '';
            editExcerpt.value = data.extracto || '';
            editBody.value = data.body || '';
            modal.showModal();
          });
        });

        document.getElementById('btn-new-post')?.addEventListener('click', () => {
          modalTitle.textContent = 'Nuevo Artículo para la Guía Rural y Blog';
          editType.value = 'blog';
          editId.value = 'nuevo-articulo-' + Date.now();
          editTitle.value = '';
          editMeta1.value = 'Rutas y Naturaleza';
          editExcerpt.value = '';
          editBody.value = '## Nuevo artículo sobre el Valle del Tiétar\n\nEscribe aquí el contenido...';
          modal.showModal();
        });

        document.getElementById('btn-close-modal')?.addEventListener('click', () => modal.close());
        document.getElementById('btn-cancel-modal')?.addEventListener('click', () => modal.close());

        document.getElementById('form-modal-editor')?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const item = {
            type: editType.value,
            id: editId.value,
            title: editTitle.value,
            meta1: editMeta1.value,
            image: editImage.value,
            excerpt: editExcerpt.value,
            body: editBody.value,
          };
          localStorage.setItem(`keystatic_${item.type}_${item.id}`, JSON.stringify(item));
          try {
            await fetch('/api/keystatic-save.php', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ collection: item.type, item }),
            });
          } catch {}
          modal.close();
          showToast(`✓ Guardado "${item.title}" en la colección ${item.type}.`);
        });
      })();
    </script>
  </body>
</html>
