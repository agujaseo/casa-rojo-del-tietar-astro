---
import Layout from '../../layouts/Layout.astro';
import { ratesData, faqs } from '../../data/siteData';

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Tarifas y Condiciones', url: '/tarifas' }
];
---

<Layout
  title="Tarifas, Ofertas y Condiciones de Reserva | Casa Rojo del Tiétar"
  description="Consulta los precios de alquiler íntegro de Casa Rojo del Tiétar (10-13 personas): desde 200 €/noche entre semana, 375 €/noche fin de semana y Oferta Semana Completa por 1.400 €. Desayuno incluido."
  breadcrumbs={breadcrumbs}
  faqItems={faqs}
>
  <!-- Hero Section -->
  <section class="relative pt-32 pb-20 lg:pt-40 lg:pb-24 bg-[#1c1b1a] text-white overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-35">
      <img
        src="/uploads/slider_tarifas.jpg"
        alt="Casa Rojo del Tiétar tarifas alquiler íntegro"
        class="w-full h-full object-cover"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[#1c1b1a] via-[#1c1b1a]/75 to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-xs uppercase tracking-widest text-stone-400">
          <li><a href="/" class="hover:text-white transition-colors">Inicio</a></li>
          <li>/</li>
          <li class="text-[#ffb4a0] font-semibold">Tarifas y Condiciones</li>
        </ol>
      </nav>

      <div class="max-w-3xl">
        <span class="inline-block px-3.5 py-1.5 rounded-full bg-[#703829]/80 border border-[#ffb4a0]/30 text-[#ffb4a0] text-xs font-bold uppercase tracking-widest mb-4">
          Transparencia total · Reserva directa sin comisiones
        </span>
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6">
          Tarifas de Alquiler Íntegro <span class="italic font-normal text-[#ffb4a0]">(10 a 13 personas)</span>
        </h1>
        <p class="text-stone-300 text-lg leading-relaxed">
          Alquila <strong>Casa Rojo del Tiétar</strong> de forma 100% exclusiva para tu grupo. Todas nuestras tarifas incluyen el <strong>desayuno mediterráneo completo</strong>, suministros, leña/chimenea, WiFi y ropa de cama y baño.
        </p>
      </div>
    </div>
  </section>

  <!-- Pricing Cards -->
  <section class="py-20 bg-[#fff8f5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
        <!-- Entre Semana -->
        <div class="bg-white rounded-3xl p-8 lg:p-10 border border-stone-200/80 shadow-sm flex flex-col justify-between">
          <div>
            <span class="inline-block px-3 py-1 rounded-full bg-stone-100 text-stone-700 text-xs font-bold uppercase tracking-wider mb-4">
              Domingo a Jueves
            </span>
            <h2 class="font-serif text-2xl font-bold text-stone-900 mb-2">Tarifa Entre Semana</h2>
            <p class="text-stone-500 text-sm mb-6">Ideal para teletrabajo en grupo, escapadas tranquilas o desconexión entre semana (excepto festivos y agosto).</p>
            <div class="flex items-baseline gap-2 mb-6 pb-6 border-b border-stone-100">
              <span class="font-serif text-5xl font-bold text-[#703829]">200 €</span>
              <span class="text-stone-500 text-sm font-medium">/ noche (casa completa)</span>
            </div>
            <ul class="space-y-3 text-sm text-stone-700 mb-8">
              <li class="flex items-center gap-2.5"><span class="text-[#703829] font-bold">✓</span> Alquiler íntegro 5 suites (hasta 10 plazas base)</li>
              <li class="flex items-center gap-2.5"><span class="text-[#703829] font-bold">✓</span> Sale a solo <strong>20 € por persona/noche</strong></li>
              <li class="flex items-center gap-2.5"><span class="text-[#703829] font-bold">✓</span> Desayuno mediterráneo incluido</li>
              <li class="flex items-center gap-2.5"><span class="text-[#703829] font-bold">✓</span> Estancia mínima: 2 noches</li>
              <li class="flex items-center gap-2.5"><span class="text-[#703829] font-bold">✓</span> Camas supletorias (hasta 3): +10 €/cama</li>
            </ul>
          </div>
          <a href="/reservas?tarifa=entre-semana" class="w-full py-4 rounded-xl bg-stone-900 text-white text-center font-semibold text-sm hover:bg-[#703829] transition-colors">
            Solicitar Fechas Entre Semana
          </a>
        </div>

        <!-- Fin de Semana y Verano (Destacado) -->
        <div class="bg-[#703829] text-white rounded-3xl p-8 lg:p-10 shadow-2xl relative flex flex-col justify-between lg:-translate-y-3">
          <div class="absolute -top-4 right-8 px-4 py-1 rounded-full bg-[#ffb4a0] text-[#411308] text-xs font-extrabold uppercase tracking-widest shadow-md">
            Más Solicitado
          </div>
          <div>
            <span class="inline-block px-3 py-1 rounded-full bg-white/15 text-[#ffdbd1] text-xs font-bold uppercase tracking-wider mb-4">
              Viernes, Sábados, Festivos y Agosto
            </span>
            <h2 class="font-serif text-2xl font-bold mb-2">Fin de Semana y Verano</h2>
            <p class="text-[#ffdbd1]/90 text-sm mb-6">Tarifa para noches de viernes, sábado, vísperas de festivos y temporada de verano (del 31 de julio al 31 de agosto).</p>
            <div class="flex items-baseline gap-2 mb-6 pb-6 border-b border-white/15">
              <span class="font-serif text-5xl font-bold text-white">375 €</span>
              <span class="text-[#ffdbd1] text-sm font-medium">/ noche (casa completa)</span>
            </div>
            <ul class="space-y-3 text-sm text-[#ffdbd1] mb-8">
              <li class="flex items-center gap-2.5"><span class="text-[#ffb4a0] font-bold">✓</span> Alquiler íntegro 5 suites con baño privado</li>
              <li class="flex items-center gap-2.5"><span class="text-[#ffb4a0] font-bold">✓</span> Sale a solo <strong>37,50 € por persona/noche</strong></li>
              <li class="flex items-center gap-2.5"><span class="text-[#ffb4a0] font-bold">✓</span> Desayuno mediterráneo completo incluido</li>
              <li class="flex items-center gap-2.5"><span class="text-[#ffb4a0] font-bold">✓</span> Uso exclusivo de salón con chimenea y barbacoa</li>
              <li class="flex items-center gap-2.5"><span class="text-[#ffb4a0] font-bold">✓</span> Camas supletorias (hasta 13 plazas): +10 €/cama</li>
            </ul>
          </div>
          <a href="/reservas?tarifa=fin-de-semana" class="w-full py-4 rounded-xl bg-white text-[#703829] text-center font-bold text-sm hover:bg-[#ffdbd1] transition-colors shadow-lg">
            Reservar Fin de Semana
          </a>
        </div>

        <!-- Promo Aniversario Semana Completa -->
        <div class="bg-white rounded-3xl p-8 lg:p-10 border-2 border-[#59614e]/40 shadow-sm flex flex-col justify-between">
          <div>
            <span class="inline-block px-3 py-1 rounded-full bg-[#dde6cd] text-[#171e0f] text-xs font-bold uppercase tracking-wider mb-4">
              🎁 Promoción Especial Aniversario
            </span>
            <h2 class="font-serif text-2xl font-bold text-stone-900 mb-2">Oferta Semana Completa</h2>
            <p class="text-stone-500 text-sm mb-6">Disfruta de 7 días completos en la Sierra de San Vicente y Valle del Tiétar con un descuento extraordinario.</p>
            <div class="flex items-baseline gap-2 mb-6 pb-6 border-b border-stone-100">
              <span class="font-serif text-5xl font-bold text-[#59614e]">1.400 €</span>
              <span class="text-stone-500 text-sm font-medium">/ semana completa</span>
            </div>
            <ul class="space-y-3 text-sm text-stone-700 mb-8">
              <li class="flex items-center gap-2.5"><span class="text-[#59614e] font-bold">✓</span> Ahorro directo sobre la tarifa por noche</li>
              <li class="flex items-center gap-2.5"><span class="text-[#59614e] font-bold">✓</span> Casa íntegra para 10 personas (hasta 13 con supletorias)</li>
              <li class="flex items-center gap-2.5"><span class="text-[#59614e] font-bold">✓</span> Desayuno mediterráneo incluido</li>
              <li class="flex items-center gap-2.5"><span class="text-[#59614e] font-bold">✓</span> Acceso a piscina municipal a 200 m en verano</li>
              <li class="flex items-center gap-2.5"><span class="text-[#59614e] font-bold">✓</span> Ideal para vacaciones familiares en julio y agosto</li>
            </ul>
          </div>
          <a href="/reservas?tarifa=semana-aniversario" class="w-full py-4 rounded-xl bg-[#59614e] text-white text-center font-semibold text-sm hover:bg-[#414937] transition-colors">
            Reservar Oferta Semanal (1.400 €)
          </a>
        </div>
      </div>

      <!-- Interactive Price Calculator -->
      <div class="mt-16 bg-white rounded-3xl p-8 lg:p-12 border border-stone-200/80 shadow-md">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          <div class="lg:col-span-5 space-y-4">
            <span class="text-xs font-bold uppercase tracking-widest text-[#703829]">Simulador rápido</span>
            <h3 class="font-serif text-2xl sm:text-3xl font-bold text-stone-900">
              Calcula el presupuesto orientativo para tu grupo
            </h3>
            <p class="text-stone-600 text-sm leading-relaxed">
              Introduce cuántas noches de fin de semana o entre semana queréis alojaros y si necesitáis camas supletorias (para grupos de 11, 12 o 13 personas).
            </p>
          </div>

          <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-3 gap-6 bg-[#fff8f5] p-6 rounded-2xl border border-stone-200/60">
            <div>
              <label for="calc-finde" class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-2">Noches Vie/Sáb/Ago (375€)</label>
              <input id="calc-finde" type="number" min="0" max="14" value="2" class="w-full px-4 py-3 rounded-xl bg-white border border-stone-300 font-bold text-stone-900 focus:outline-none focus:border-[#703829]" />
            </div>
            <div>
              <label for="calc-semana" class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-2">Noches Dom-Jue (200€)</label>
              <input id="calc-semana" type="number" min="0" max="14" value="0" class="w-full px-4 py-3 rounded-xl bg-white border border-stone-300 font-bold text-stone-900 focus:outline-none focus:border-[#703829]" />
            </div>
            <div>
              <label for="calc-supletorias" class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-2">Camas Supletorias (10€)</label>
              <select id="calc-supletorias" class="w-full px-4 py-3 rounded-xl bg-white border border-stone-300 font-bold text-stone-900 focus:outline-none focus:border-[#703829]">
                <option value="0">0 (Hasta 10 pers.)</option>
                <option value="1">1 (11 personas)</option>
                <option value="2">2 (12 personas)</option>
                <option value="3">3 (13 personas)</option>
              </select>
            </div>

            <div class="sm:col-span-3 pt-4 border-t border-stone-200 flex flex-wrap items-center justify-between gap-4">
              <div>
                <span class="block text-xs uppercase tracking-wider text-stone-500">Total estimado (Desayuno incluido)</span>
                <div class="flex items-baseline gap-3">
                  <span id="calc-total" class="font-serif text-3xl font-bold text-[#703829]">750 €</span>
                  <span id="calc-per-person" class="text-xs font-semibold text-[#59614e] bg-[#dde6cd] px-2.5 py-1 rounded-full">37,50 € / persona y noche</span>
                </div>
              </div>
              <a href="/reservas" class="px-6 py-3 rounded-xl bg-[#703829] text-white text-sm font-semibold hover:bg-[#8c4f3e] transition-colors">
                Reservar con este presupuesto →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Conditions & Policies -->
  <section class="py-20 bg-[#f7f3ee]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-[#703829] block mb-2">Normativa y Garantías</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-stone-900">
          Condiciones de Reserva, Fianza y Cancelación
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {ratesData.conditions.map((cond) => (
          <div class="bg-white p-7 rounded-2xl border border-stone-200/80 shadow-xs">
            <h3 class="font-serif text-xl font-bold text-stone-900 mb-2 flex items-center gap-2.5">
              <span class="w-2.5 h-2.5 rounded-full bg-[#703829]"></span>
              {cond.title}
            </h3>
            <p class="text-stone-600 text-sm leading-relaxed">{cond.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    const inputFinde = document.getElementById('calc-finde') as HTMLInputElement | null;
    const inputSemana = document.getElementById('calc-semana') as HTMLInputElement | null;
    const selectSuple = document.getElementById('calc-supletorias') as HTMLSelectElement | null;
    const outTotal = document.getElementById('calc-total');
    const outPerPerson = document.getElementById('calc-per-person');

    function updateCalc() {
      if (!inputFinde || !inputSemana || !selectSuple || !outTotal || !outPerPerson) return;
      const nFinde = Math.max(0, parseInt(inputFinde.value || '0', 10));
      const nSemana = Math.max(0, parseInt(inputSemana.value || '0', 10));
      const nSuple = Math.max(0, parseInt(selectSuple.value || '0', 10));
      const totalNights = Math.max(1, nFinde + nSemana);
      const guests = 10 + nSuple;

      let base = (nFinde * 375) + (nSemana * 200);
      if (nFinde + nSemana === 7 && base > 1400) {
        base = 1400; // Promo semana completa
      }
      const supleCost = nSuple * 10 * (nFinde + nSemana);
      const total = base + supleCost;
      const perPersonNight = total / (guests * totalNights);

      outTotal.textContent = `${total.toLocaleString('es-ES')} €`;
      outPerPerson.textContent = `${perPersonNight.toFixed(2).replace('.', ',')} € / persona y noche (${guests} pers.)`;
    }

    inputFinde?.addEventListener('input', updateCalc);
    inputSemana?.addEventListener('input', updateCalc);
    selectSuple?.addEventListener('change', updateCalc);
  </script>
</Layout>
