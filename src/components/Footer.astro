---
import { siteConfig } from '../data/siteData';
const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-surface-container-low text-on-surface-variant pt-16 pb-12 border-t border-outline-variant/40">
  <div class="max-w-[1360px] mx-auto px-5 md:px-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 mb-14">
      <!-- Columna 1: Identidad y Ubicación -->
      <div class="md:col-span-4 space-y-4">
        <a href="/" class="flex items-center gap-3">
          <img
            src={siteConfig.logo}
            alt="Logo Casa Rojo del Tiétar"
            width="44"
            height="41"
            loading="lazy"
            decoding="async"
            class="h-10 w-auto object-contain rounded-sm"
          />
          <div>
            <span class="font-serif text-2xl text-primary block leading-none">
              {siteConfig.name}
            </span>
            <span class="label-caps text-secondary mt-1 block">
              Valle del Tiétar · Toledo
            </span>
          </div>
        </a>
        <p class="text-sm text-on-surface-variant leading-relaxed max-w-sm">
          Antiguo pajar de piedra rehabilitado en La Iglesuela con vistas a la Sierra de Gredos y al Monte del Piélago. Alquiler íntegro de 240 m² con 5 suites con baño privado, desayuno casero diario y patio con barbacoa.
        </p>
        <div class="pt-1">
          <span class="label-caps text-secondary block mb-1">Ubicación Oficial</span>
          <p class="text-sm text-on-surface font-medium">{siteConfig.address.full}</p>
        </div>
      </div>

      <!-- Columna 2: La Casa y Estancias -->
      <div class="md:col-span-3 space-y-3">
        <span class="label-caps text-secondary block mb-2">Explorar la Casa</span>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/" class="hover:text-primary transition-colors">Nuestra Casa (240 m²)</a></li>
          <li><a href="/estancias" class="hover:text-primary transition-colors">Galería y las 5 Suites con Baño</a></li>
          <li><a href="/servicios" class="hover:text-primary transition-colors">Servicios y Desayuno Incluido</a></li>
          <li><a href="/tarifas" class="hover:text-primary transition-colors">Tarifas y Promoción Semanal</a></li>
          <li><a href="/entorno" class="hover:text-primary transition-colors">Entorno: La Iglesuela y Gredos</a></li>
          <li><a href="/blog" class="hover:text-primary transition-colors">Guía Rural y Rutas (GR-63)</a></li>
        </ul>
      </div>

      <!-- Columna 3: Resumen Rápido -->
      <div class="md:col-span-2 space-y-3">
        <span class="label-caps text-secondary block mb-2">Datos Clave</span>
        <ul class="space-y-2 text-sm text-on-surface-variant">
          <li>• 10 a 13 huéspedes</li>
          <li>• 5 Suites + 5 baños + 1 aseo</li>
          <li>• 2 Suites con bañera exenta</li>
          <li>• 1 Suite adaptada PMR</li>
          <li>• Desayuno diario incluido</li>
          <li>• Leña gratis y Pet-Friendly</li>
          <li>• Estancia mínima: 2 noches</li>
        </ul>
      </div>

      <!-- Columna 4: Contacto Directo y Reservas -->
      <div class="md:col-span-3 space-y-3">
        <span class="label-caps text-secondary block mb-2">Información y Reservas</span>
        <p class="text-sm text-on-surface-variant">
          Trato directo con los propietarios, sin comisiones de portales intermediarios:
        </p>
        <div class="space-y-1.5 pt-1">
          <p class="text-base text-primary font-semibold">
            <a href={`tel:${siteConfig.phone1Raw}`} class="hover:underline">{siteConfig.phone1}</a>
            <span class="text-outline mx-1">/</span>
            <a href={`tel:${siteConfig.phone2Raw}`} class="hover:underline">{siteConfig.phone2}</a>
          </p>
          <p class="text-sm">
            <a href={`mailto:${siteConfig.email}`} class="text-on-surface hover:text-primary underline underline-offset-4">
              {siteConfig.email}
            </a>
          </p>
        </div>
        <div class="pt-3 flex flex-wrap gap-3">
          <a
            href="/reservas"
            class="inline-flex items-center px-4 py-2 bg-primary-container text-on-primary rounded text-xs font-semibold uppercase tracking-wider hover:bg-primary transition-colors"
          >
            Reservar Ahora
          </a>
          <a
            href={siteConfig.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-3.5 py-2 border border-outline-variant rounded text-xs font-semibold text-on-surface hover:bg-surface-container transition-colors"
          >
            Facebook @Rojodeltietar
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Legal Bar -->
    <div class="pt-8 border-t border-outline-variant/40 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-outline">
      <p>
        © {currentYear} {siteConfig.name} ({siteConfig.address.locality}, Toledo). Todos los derechos reservados.
      </p>
      <div class="flex flex-wrap items-center gap-5">
        <a href="/aviso-legal" class="hover:text-primary transition-colors">Aviso Legal</a>
        <a href="/privacidad" class="hover:text-primary transition-colors">Política de Privacidad</a>
        <a href="/cookies" class="hover:text-primary transition-colors">Política de Cookies</a>
        <a href="/keystatic" class="hover:text-primary transition-colors opacity-75">CMS Keystatic</a>
      </div>
    </div>
  </div>
</footer>
