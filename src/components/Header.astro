---
import { siteConfig } from '../data/siteData';

const pathname = Astro.url.pathname;

const navItems = [
  { label: 'La Casa', href: '/' },
  { label: 'Estancias y Galería', href: '/estancias' },
  { label: 'Servicios', href: '/servicios' },
  { label: 'Tarifas', href: '/tarifas' },
  { label: 'Entorno', href: '/entorno' },
  { label: 'Guía y Blog', href: '/blog' },
  { label: 'Contacto', href: '/contacto' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header
  id="site-header"
  class="fixed top-0 left-0 w-full z-50 bg-surface/95 backdrop-blur-md border-b border-outline-variant/30 transition-all duration-300"
>
  <!-- Top Bar Informativa (Solo Desktop) -->
  <div class="bg-primary text-on-primary text-xs py-1.5 px-4 hidden md:block">
    <div class="max-w-[1360px] mx-auto px-6 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <span class="tracking-wide">
          📍 La Iglesuela (Toledo) · Corazón del Valle del Tiétar · A 115 km de Madrid
        </span>
        <span class="opacity-40">|</span>
        <span class="text-primary-fixed font-medium">
          Desayuno casero diario y leña incluidos en todas las estancias
        </span>
      </div>
      <div class="flex items-center gap-4">
        <span>Información y reservas:</span>
        <a href={`tel:${siteConfig.phone1Raw}`} class="font-semibold hover:text-primary-fixed transition-colors">
          {siteConfig.phone1}
        </a>
        <span>/</span>
        <a href={`tel:${siteConfig.phone2Raw}`} class="font-semibold hover:text-primary-fixed transition-colors">
          {siteConfig.phone2}
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar (Optimizada para Móvil y Desktop) -->
  <div class="h-16 sm:h-20 max-w-[1360px] mx-auto px-3.5 sm:px-6 lg:px-10 flex items-center justify-between gap-2">
    <a href="/" class="flex items-center gap-2.5 sm:gap-3.5 group min-w-0" aria-label="Ir a inicio de Casa Rojo del Tiétar">
      <img
        src={siteConfig.logo}
        alt="Logo Casa Rojo del Tiétar"
        width="44"
        height="42"
        loading="eager"
        decoding="async"
        class="h-9 sm:h-11 w-auto shrink-0 object-contain rounded-sm transition-transform duration-300 group-hover:scale-105"
      />
      <div class="flex flex-col min-w-0">
        <span class="font-serif text-[16px] sm:text-[21px] font-medium tracking-tight text-primary leading-tight truncate">
          Casa Rojo del Tiétar
        </span>
        <span class="text-[9px] sm:text-[10px] uppercase tracking-[0.12em] text-secondary font-semibold mt-0.5 truncate">
          <span class="sm:hidden">La Iglesuela · 10-13 Plazas</span>
          <span class="hidden sm:inline">Casa Rural Boutique · 10-13 Plazas</span>
        </span>
      </div>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden xl:flex items-center gap-6 shrink-0" aria-label="Navegación principal">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'text-[14px] font-medium transition-colors py-1 whitespace-nowrap',
            isActive(item.href)
              ? 'text-primary font-semibold border-b-2 border-primary'
              : 'text-on-surface-variant hover:text-primary',
          ]}
        >
          {item.href === '/' ? 'Nuestra Casa' : item.label}
        </a>
      ))}
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-1.5 sm:gap-3 shrink-0">
      <a
        href={`https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent('Hola, me gustaría consultar disponibilidad para Casa Rojo del Tiétar.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:inline-flex items-center gap-2 px-3.5 py-2 rounded-lg border border-outline-variant/60 text-on-surface text-xs font-semibold uppercase tracking-wider hover:bg-surface-container transition-colors"
        aria-label="Consultar por WhatsApp"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
        <span>WhatsApp</span>
      </a>

      <!-- Botón compacto en móvil, completo en tablet/desktop -->
      <a
        href="/reservas"
        class="inline-flex items-center justify-center px-3 py-1.5 sm:px-5 sm:py-2.5 bg-primary-container text-on-primary rounded-lg text-xs sm:text-sm font-semibold tracking-wide transition-colors duration-200 hover:bg-primary shadow-xs whitespace-nowrap"
      >
        <span class="sm:hidden">Reservar</span>
        <span class="hidden sm:inline">Reserva Ahora</span>
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="xl:hidden inline-flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-lg text-primary hover:bg-surface-container transition-colors cursor-pointer"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
      >
        <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div
    id="mobile-menu"
    class="hidden xl:hidden bg-surface border-t border-outline-variant/40 px-5 py-5 shadow-2xl max-h-[calc(100vh-4rem)] overflow-y-auto"
  >
    <nav class="flex flex-col space-y-1" aria-label="Menú móvil">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'py-2.5 px-3 rounded-xl text-[15px] font-medium flex items-center justify-between transition-colors',
            isActive(item.href)
              ? 'bg-primary/10 text-primary font-bold'
              : 'text-on-surface hover:bg-surface-container-low',
          ]}
        >
          <span>{item.label}</span>
          <span class="text-xs text-secondary">→</span>
        </a>
      ))}

      <div class="pt-4 mt-2 border-t border-outline-variant/30 flex flex-col gap-2.5">
        <a
          href="/reservas"
          class="w-full py-3 bg-primary-container text-on-primary text-center rounded-xl font-semibold text-sm shadow-xs"
        >
          Consultar Disponibilidad y Reservar
        </a>
        <div class="grid grid-cols-2 gap-2">
          <a
            href={`https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent('Hola, me gustaría consultar disponibilidad para Casa Rojo del Tiétar.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="py-2.5 px-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-center text-xs font-bold flex items-center justify-center gap-1.5"
          >
            <span>💬</span> WhatsApp Directo
          </a>
          <a
            href={`tel:${siteConfig.phone1Raw}`}
            class="py-2.5 px-3 rounded-xl bg-surface-container-low border border-outline-variant/40 text-primary text-center text-xs font-bold flex items-center justify-center gap-1.5"
          >
            <span>📞</span> {siteConfig.phone1}
          </a>
        </div>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    if (btn && menu) {
      btn.addEventListener('click', () => {
        const isHidden = menu.classList.toggle('hidden');
        btn.setAttribute('aria-expanded', String(!isHidden));
        if (iconOpen && iconClose) {
          iconOpen.classList.toggle('hidden', !isHidden);
          iconClose.classList.toggle('hidden', isHidden);
        }
      });
    }
  })();
</script>
