---
import { siteConfig } from '../data/siteData';

const pathname = Astro.url.pathname;

const navItems = [
  { label: 'La Casa', href: '/' },
  { label: 'Estancias y Galería', href: '/estancias' },
  { label: 'Servicios', href: '/servicios' },
  { label: 'Tarifas', href: '/tarifas' },
  { label: 'Entorno', href: '/entorno' },
  { label: 'Guía y Blog', href: '/blog' },
  { label: 'Contacto', href: '/contacto' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header
  id="site-header"
  class="fixed top-0 left-0 w-full z-50 bg-surface/90 backdrop-blur-md border-b border-outline-variant/30 transition-all duration-300"
>
  <!-- Top Bar Informativa -->
  <div class="bg-primary text-on-primary text-xs py-1.5 px-4 hidden md:block">
    <div class="max-w-[1360px] mx-auto px-6 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <span class="tracking-wide">
          📍 La Iglesuela (Toledo) · Corazón del Valle del Tiétar · A 115 km de Madrid
        </span>
        <span class="opacity-40">|</span>
        <span class="text-primary-fixed font-medium">
          Desayuno casero diario y leña incluidos en todas las estancias
        </span>
      </div>
      <div class="flex items-center gap-4">
        <span>Información y reservas:</span>
        <a href={`tel:${siteConfig.phone1Raw}`} class="font-semibold hover:text-primary-fixed transition-colors">
          {siteConfig.phone1}
        </a>
        <span>/</span>
        <a href={`tel:${siteConfig.phone2Raw}`} class="font-semibold hover:text-primary-fixed transition-colors">
          {siteConfig.phone2}
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="h-20 max-w-[1360px] mx-auto px-5 md:px-10 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3.5 group" aria-label="Ir a inicio de Casa Rojo del Tiétar">
      <img
        src={siteConfig.logo}
        alt="Logo Casa Rojo del Tiétar"
        width="48"
        height="45"
        loading="eager"
        decoding="async"
        class="h-11 w-auto object-contain rounded-sm transition-transform duration-300 group-hover:scale-105"
      />
      <div class="flex flex-col">
        <span class="font-serif text-[22px] font-medium tracking-tight text-primary leading-none">
          Casa Rojo del Tiétar
        </span>
        <span class="label-caps text-secondary mt-1">
          Casa Rural Boutique · 10-13 Plazas
        </span>
      </div>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden xl:flex items-center gap-6" aria-label="Navegación principal">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'text-[14px] font-medium transition-colors py-1',
            isActive(item.href)
              ? 'text-primary font-semibold border-b-2 border-primary'
              : 'text-on-surface-variant hover:text-primary',
          ]}
        >
          {item.href === '/' ? 'Nuestra Casa' : item.label}
        </a>
      ))}
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-3">
      <a
        href={`https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent('Hola, me gustaría consultar disponibilidad para Casa Rojo del Tiétar.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2 px-3.5 py-2 rounded border border-outline-variant/60 text-on-surface text-xs font-semibold uppercase tracking-wider hover:bg-surface-container transition-colors"
        aria-label="Consultar por WhatsApp"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
        <span>WhatsApp</span>
      </a>

      <a
        href="/reservas"
        class="inline-flex items-center justify-center px-5 py-2.5 bg-primary-container text-on-primary rounded text-sm font-medium tracking-wide transition-colors duration-200 hover:bg-primary shadow-sm"
      >
        Reserva Ahora
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="xl:hidden inline-flex items-center justify-center p-2 rounded text-primary hover:bg-surface-container transition-colors"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon-path" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div
    id="mobile-menu"
    class="hidden xl:hidden bg-surface border-t border-outline-variant/40 px-6 py-6 shadow-lg"
  >
    <nav class="flex flex-col space-y-3" aria-label="Menú móvil">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'py-2 text-base font-medium border-b border-outline-variant/20',
            isActive(item.href) ? 'text-primary font-semibold' : 'text-on-surface-variant',
          ]}
        >
          {item.label}
        </a>
      ))}
      <div class="pt-4 flex flex-col gap-3">
        <a
          href="/reservas"
          class="w-full py-3 bg-primary-container text-on-primary text-center rounded font-medium"
        >
          Consultar Disponibilidad y Reservar
        </a>
        <div class="flex items-center justify-center gap-4 text-sm text-primary font-semibold pt-2">
          <a href={`tel:${siteConfig.phone1Raw}`}>📞 {siteConfig.phone1}</a>
          <span>·</span>
          <a href={`tel:${siteConfig.phone2Raw}`}>📞 {siteConfig.phone2}</a>
        </div>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (btn && menu) {
      btn.addEventListener('click', () => {
        const isHidden = menu.classList.toggle('hidden');
        btn.setAttribute('aria-expanded', String(!isHidden));
      });
    }
  })();
</script>
